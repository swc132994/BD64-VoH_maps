// Тэги для ботов

TAGBD_BOT1 = "Пехотинец";
TAGBD_BOT2 = "Разрушитель";
TAGBD_BOT3 = "Палач";
TAGBD_BOT4 = "Поджигатель войны";

BOT1_INTRO_TXT1 = "Добро пожаловать в рай!";
BOT1_INTRO_TXT2 = "Давайте начнем эту вечеринку.";
BOT1_INTRO_TXT3 = "Что ж, пора повеселиться!";
BOT1_INTRO_TXT4 = "Отлично, опять эта дыра!";
BOT1_INTRO_TXT5 = "Как долго нам придется возиться в этих дырах?";
BOT1_INTRO_TXT6 = "Я убью вас всех!";
BOT1_INTRO_TXT7 = "Погнали!";
BOT1_INTRO_TXT8 = "Я иду за тобой!";
BOT1_INTRO_TXT9 = "Просто жди там. Я скоро буду.";
BOT1_INTRO_TXT10 = "Я получу от этого удовольствие.";
BOT1_INTRO_TXT11 = "Пора выбить кому-нибудь зубы!";
BOT1_INTRO_TXT12 = "У вас, идиотов, нет ни единого шанса!";

BOT1_FRAG_TXT1 = "Лежи на земле, черт возьми!";
BOT1_FRAG_TXT2 = "Оставайся мертвым на этот раз!";
BOT1_FRAG_TXT3 = "Не вставай ради меня!";
BOT1_FRAG_TXT4 = "Сюрприз! Ты мертв!";
BOT1_FRAG_TXT5 = "Жадный, как свинья!";
BOT1_FRAG_TXT6 = "Как дела там, внизу?";
BOT1_FRAG_TXT7 = "Покойся по кусочкам.";
BOT1_FRAG_TXT8 = "Спишь на работе?";
BOT1_FRAG_TXT9 = "Круто!";
BOT1_FRAG_TXT10 = "Вставай, ленивый ублюдок. Это просто царапина!";
BOT1_FRAG_TXT11 = "На миг твои сладкие вопли агонии заставили голоса замолчать.";
BOT1_FRAG_TXT12 = "Я помню тебя на Фобосе. Ты сбежал. Но теперь я тебя нашел.";

BOT1_KILLED_TXT1 = "Ублюдок, тебе просто повезло!";
BOT1_KILLED_TXT2 = "Ты, блядь, заплатишь за это!";
BOT1_KILLED_TXT3 = "Ах ты мелок сранный!";
BOT1_KILLED_TXT4 = "Откуда, черт возьми, ты взялся?!";
BOT1_KILLED_TXT5 = "Воняет дерьмом!";

BOT1_ROAMING_TXT1 = "Где ты, черт возьми?";
BOT1_ROAMING_TXT2 = "Отвали или получишь пизды!";
BOT1_ROAMING_TXT3 = "Ты не сможешь прятаться от меня вечно!";
BOT1_ROAMING_TXT4 = "Давай немного украсим стену!";
BOT1_ROAMING_TXT5 = "Выходи, выходи, где бы ты ни был!";

BOT1_NOROAMING_TXT1 = "Вы, ублюдки, меня не остановите!";
BOT1_NOROAMING_TXT2 = "Мы еще не закончили!";
BOT1_NOROAMING_TXT3 = "Подожди! Мы еще не закончили!";
BOT1_NOROAMING_TXT4 = "Дай мне хоть шанс!";
BOT1_NOROAMING_TXT5 = "Это превращается в кал!";

BOT1_ENRAGED_TXT1 = "ОТВАЛИ, ИДИОТ!";
BOT1_ENRAGED_TXT2 = "ТЫ НАПРАШИВАЕШЬСЯ НА ПЫТКИ!!";
BOT1_ENRAGED_TXT3 = "Я ТЕБЯ НА КУСКИ РАЗОРВУ!";
BOT1_ENRAGED_TXT4 = "ПОШЕЛ НАХУЙ ОТСЮДА!";
BOT1_ENRAGED_TXT5 = "Я ЗАСТАВЛЮ ТЕБЯ ЗАПЛАТИТЬ!";

BOT1_DEMORALIZED_TXT1 = "Я хочу, чтобы это дерьмо просто прекратилось.";
BOT1_DEMORALIZED_TXT2 = "Я пойду посплю. Разбудите меня потом.";
BOT1_DEMORALIZED_TXT3 = "Меня просто каждый раз поиметь пытаются!";
BOT1_DEMORALIZED_TXT4 = "Я больше не могу терпеть эту херню!";
BOT1_DEMORALIZED_TXT5 = "Я с тем же успехом могу просто сдаться!";

BOT1_WIN_TXT1 = "Я обожаю раскрашивать карту кровью и кишками!";
BOT1_WIN_TXT2 = "Что ж, всё прошло отлично!";
BOT1_WIN_TXT3 = "Мне понравилось!";
BOT1_WIN_TXT4 = "Моя работа окончена. Пора двигаться дальше...";
BOT1_WIN_TXT5 = "Все дороги ведут тебя прямо в ад.";

BOT1_LOSE_TXT1 = "В следующий раз тебе лучше беречься.";
BOT1_LOSE_TXT2 = "Рад, что это закончилось.";
BOT1_LOSE_TXT3 = "Какая куча дерьма!";
BOT1_LOSE_TXT4 = "Думаю, на сегодня с меня хватит!";
BOT1_LOSE_TXT5 = "В следующий раз тебе так не повезет!";
BOT1_LOSE_TXT6 = "Погладь себя по головке!";
BOT1_LOSE_TXT7 = "Ублюдок, тебе просто повезло!";
BOT1_LOSE_TXT8 = "Это еще не конец. Я вернусь и закончу это!";

