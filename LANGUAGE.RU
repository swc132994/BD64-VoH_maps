////////////////////////////////////////////////////////////////////////////////
// Intermission screens

INTRO01_TXT = "Вы успешно прошли!\n"
"Когда дверь лифта закрывается за вами,\n"
"вы слышите человеческие и демонические стоны и крики,\n"
"смешанные со стрельбой и взрывами.\n"
"\n"
"В конце концов вы не слышите ничего, кроме тишины.\n"
"Ваша команда была совершенно не готова к тому, что\n"
"ждало на месте посадки.\n"
"\n"
"Через мгновение вы понимаете, что вы одни.\n"
"\n"
"Ощущение внутри базы кажется неправильным, и этот запах,\n"
"вы хорошо помните этот запах смерти.\n"
"\n"
"Теперь пути назад нет.\n"
"Вы готовите свое оружие и идете на базу.\n";

INTER01_TXT = "Приказ ОАК заключался в том, чтобы устранить демоническую угрозу.\n"
"\n"
"Вы зачистили базу и добрались до портала.\n"
"Однако, похоже, ОАК ничему не научился\n"
"со времени первого вторжения демонов!\n"
"\n"
"Вы рассматриваете возможность деактивации последовательности разрушения,\n"
"но вы знаете, что ОАК никогда ничему не научится.\n"
"\n"
"Вы собираетесь убедиться, что\n"
"ОАК не сможет снова все испортить!\n"
"Пусть ворота и эксперименты ОАК будут уничтожены\n"
"вместе с базой.\n"
"\n"
"Когда вы проходите через портал и дымка рассеивается,\n"
"вы осознаете, что ситуация знакома.\n"
"Ваш хохот и кровожадный крик эхом разносятся, когда\n"
"вы снова оказываетесь\n"
"среди...\n";

INTER02_TXT = "Глубокая тишина напоминает вам военный морг.\n"
"\n"
"Вы знали, что объект\n"
"имеет уровень секретности.\n"
"\n"
"У О.А.К. были веские\n"
"причины скрывать это место.\n"
"\n"
"Вы задаетесь вопросом, что это\n"
"может быть...";

INTER03_TXT = "Ты улыбаешься.\n"
"На какое странное место\n"
"ты наткнулся?\n"
"\n"
"Демоны не ожидали,\n"
"что ты доберешься так далеко.\n"
"Ты чувствуешь, что их демоническое\n"
"присутствие ждет тебя...\n"
"\n"
"Пусть они попробуют свои кишки!\n";

INTER04_TXT = "Когда вы проходите,\n"
"резкий запах заставляет вас чувствовать себя отвратительно.\n"
"\n"
"Смерть и трупы демонов повсюду!\n"
"\n"
"Никакой кошмар не мог бы\n"
"подготовить вас к этой реальности.\n"
"\n"
"Вы понимаете, что это\n"
"место не предназначено для\n"
"живых.\n";

INTER05_TXT = "Поздравляю!\n"
"Вы нашли...\n"
"\n"
"ЛИХОРАДКА\n"
"\n"
"Только лучшие пожинают\n"
"его награды.\n";

INTER06_TXT = "Наконец-то...\n"
"Мать демонов убита!\n"
"Впервые демоны знают, что такое страх.\n"
"Пока кровь и пот льются из твоего шлема,\n"
"вы видите чистый ужас демонов, когда они убегают.\n"
"\n"
"Вы хотели провести отпуск и пройти терапию,\n"
"но, к сожалению, твое чувство победы недолговечно.\n"
"\n"
"База и портал уничтожены. Назад пути нет!\n"
"\n"
"Поскольку безумие и жажда крови медленно поглощают твой разум,\n"
"вы думаете, что лучше позволить ОАК думать, что вы умерли.\n"
"\n"
"Зная, что Ад не может быть уничтожен,\n"
"вы решаете остаться в Аду.\n"
"Вы продолжаете свои бесконечные убийства, чтобы гарантировать, что\n"
"Гибель не вернется, пока ад боится вашего имени...\n";

INTER07_TXT = "Вы решили отправиться в неизвестность\n"
"прежде чем столкнуться с угрозой, таящейся в самом сердце Ада.\n"
"\n"
"После прибытия в странное измерение вы\n"
"\n"
"видите старого друга, который хочет пригласить вас на ужин.\n"
"\n"
"Пусть начнется развлечение!\n";

INTER08_TXT = "Наконец-то вы прибыли в логово матери-демона.\n"
"\n"
"Пройдя через ад, мать демонов теперь перед вами.\n"
"\n"
"Идите и отдайте ей дань уважения.\n"
"\n"
"Она ждет вас...\n";

//Reckoning Episode Intermissions

RECMID_TXT = "Стоя среди разлагающихся туш\n"
"хранителя портала и его прислужников, вы\n"
"смеетесь над жалкими попытками ада остановить\n"
"ваше вторжение в их родной мир.\n"
"Впереди лежат последние врата в\n"
"проклятые владения демонов — ваш единственный шанс\n"
"покончить с этим кошмаром\n"
"раз и навсегда...\n";

RECEND_TXT = "Мучительный вопль самого могущественного\n"
"существа ада оглушает вас и эхом разносится\n"
"по бесконечным просторам адской поверхности.\n"
"Странный портал открывает себя, и когда вы ступаете\n"
"в него, вы издаете тяжелый вздох\n"
"облегчения. Наконец-то демонические ужасы,\n"
"захватившие ваш мир, сокрушены\n"
"вашей могучей рукой. И если они снова поднимутся,\n"
"они всегда будут бояться вас и расплаты,\n"
"которую вы обрушили на них...\n";

