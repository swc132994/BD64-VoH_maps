// Tags for bots

TAGBD_BOT1 = "Recruta";
TAGBD_BOT2 = "Destruidor";
TAGBD_BOT3 = "Executor";
TAGBD_BOT4 = "Belicista";

BOT1_INTRO_TXT1 = "Bem-vindo ao paraíso!";
BOT1_INTRO_TXT2 = "Vamos começar essa festa.";
BOT1_INTRO_TXT3 = "Hora de me divertir um pouco!";
BOT1_INTRO_TXT4 = "Ótimo, esse buraco de minhoca de novo!";
BOT1_INTRO_TXT5 = "Quanto tempo teremos que aguentar nesses buracos?";
BOT1_INTRO_TXT6 = "Eu vou matar todos vocês!";
BOT1_INTRO_TXT7 = "Hora do show!";
BOT1_INTRO_TXT8 = "Estou indo te pegar!";
BOT1_INTRO_TXT9 = "Apenas espere aí. Chego já já.";
BOT1_INTRO_TXT10 = "Eu vou adorar isso.";
BOT1_INTRO_TXT11 = "Hora de quebrar uns dentes!";
BOT1_INTRO_TXT12 = "Vocês não têm a menor chance!";

BOT1_FRAG_TXT1 = "Fique no chão, porra!";
BOT1_FRAG_TXT2 = "Fique morto dessa vez!";
BOT1_FRAG_TXT3 = "Não se levante por minha causa!";
BOT1_FRAG_TXT4 = "Surpresa! Você está morto!";
BOT1_FRAG_TXT5 = "Ganancioso como um porco!";
BOT1_FRAG_TXT6 = "Como estão as coisas aí embaixo?";
BOT1_FRAG_TXT7 = "Descanse em pedaços.";
BOT1_FRAG_TXT8 = "Dormindo no trabalho?";
BOT1_FRAG_TXT9 = "Demais!";
BOT1_FRAG_TXT10 = "Levante-se, seu preguiçoso. É só um arranhão!";
BOT1_FRAG_TXT11 = "Por um momento, seus gritos doces de agonia calaram as vozes.";
BOT1_FRAG_TXT12 = "Eu me lembro de você em Phobos. Você fugiu. Eu te achei agora.";

BOT1_KILLED_TXT1 = "Desgraçado de sorte!";
BOT1_KILLED_TXT2 = "Você vai pagar caro por isso!";
BOT1_KILLED_TXT3 = "Seu mijo de cachorro!";
BOT1_KILLED_TXT4 = "De onde diabos você veio?!";
BOT1_KILLED_TXT5 = "Isso fede a mijo!";

BOT1_ROAMING_TXT1 = "Onde diabos você está?";
BOT1_ROAMING_TXT2 = "Recue ou vai se foder!";
BOT1_ROAMING_TXT3 = "Você não pode se esconder de mim para sempre!";
BOT1_ROAMING_TXT4 = "Vamos fazer uma redecoração!";
BOT1_ROAMING_TXT5 = "Apareça, apareça onde quer que esteja!";

BOT1_NOROAMING_TXT1 = "Vocês não vão me parar!";
BOT1_NOROAMING_TXT2 = "Ainda não terminamos!";
BOT1_NOROAMING_TXT3 = "Espere! Não acabou ainda!";
BOT1_NOROAMING_TXT4 = "Me dê uma chance, porra!";
BOT1_NOROAMING_TXT5 = "Isso está virando uma droga!";

BOT1_ENRAGED_TXT1 = "VAI SE FODER, SEU OTÁRIO!";
BOT1_ENRAGED_TXT2 = "VOCÊ ESTÁ PEDINDO PARA SER TORTURADO!!";
BOT1_ENRAGED_TXT3 = "EU VOU TE ARREBENTAR!";
BOT1_ENRAGED_TXT4 = "CAIA FORA DAQUI!";
BOT1_ENRAGED_TXT5 = "EU VOU FAZER VOCÊ PAGAR!";

BOT1_DEMORALIZED_TXT1 = "Eu só queria que esse show de horrores parasse.";
BOT1_DEMORALIZED_TXT2 = "Vou tirar um cochilo. Me acorda depois.";
BOT1_DEMORALIZED_TXT3 = "Eu só me ferro toda vez!";
BOT1_DEMORALIZED_TXT4 = "Não aguento mais essa porcaria!";
BOT1_DEMORALIZED_TXT5 = "É melhor eu desistir!";

BOT1_WIN_TXT1 = "Eu adoro pintar o mapa com sangue e tripas!";
BOT1_WIN_TXT2 = "Bom, isso correu bem!";
BOT1_WIN_TXT3 = "Eu me diverti!";
BOT1_WIN_TXT4 = "Meu trabalho aqui acabou. Hora de ir em frente...";
BOT1_WIN_TXT5 = "Todos os caminhos levam ao inferno para você.";

BOT1_LOSE_TXT1 = "Da próxima vez é melhor tomar cuidado.";
BOT1_LOSE_TXT2 = "Ainda bem que isso acabou.";
BOT1_LOSE_TXT3 = "Que monte de merda!";
BOT1_LOSE_TXT4 = "Acho que chega por hoje!";
BOT1_LOSE_TXT5 = "Você não terá tanta sorte da próxima vez!";
BOT1_LOSE_TXT6 = "Dê um tapinha nas próprias costas!";
BOT1_LOSE_TXT7 = "Maldito de sorte!";
BOT1_LOSE_TXT8 = "Isso não é o fim. Eu voltarei para terminar isso!";

